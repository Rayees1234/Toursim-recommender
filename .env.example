# Database Configuration
# Supported options for DB_ENGINE: 'auto' (detects MySQL, falls back to SQLite), 'mysql', or 'sqlite'
DB_ENGINE=auto

# MySQL Credentials (used when MySQL is running)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=tourism_dmdw

# SQLite Path (used when running in SQLite fallback mode)
SQLITE_PATH=data/processed/tourism_dw.db

# Flask Application Settings
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
